{
  "info": {
    "name": "RideMatchingSystem API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"name\": \"Alice\", \"email\": \"alice@example.com\", \"password\": \"pass123\", \"role\": \"Rider\" }" },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"email\": \"alice@example.com\", \"password\": \"pass123\" }" },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "Set Driver Availability",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/drivers/1/availability?available=true"
      }
    },
    {
      "name": "Update Driver Location",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{ \"latitude\": 37.7749, \"longitude\": -122.4194 }"
        },
        "url": "{{baseUrl}}/api/drivers/1/location"
      }
    },
    {
      "name": "Create Ride Request",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{ \"riderId\": 1, \"pickupLocation\": { \"latitude\": 37.775, \"longitude\": -122.418 }, \"dropoffLocation\": { \"latitude\": 37.776, \"longitude\": -122.419 }, \"idempotencyKey\": \"client-guid-123\" }"
        },
        "url": "{{baseUrl}}/api/rides"
      }
    },
    {
      "name": "Get Pending Rides",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rides/pending"
      }
    },
    {
      "name": "Match Ride (enqueue)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/rides/1/match"
      }
    },
    {
      "name": "Driver Accept Offer",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"offerId\": \"offer-1\", \"driverId\": 2, \"accept\": true }" },
        "url": "{{baseUrl}}/api/rides/1/accept"
      }
    },
    {
      "name": "Driver Decline Offer",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"offerId\": \"offer-1\", \"driverId\": 2 }" },
        "url": "{{baseUrl}}/api/rides/1/decline"
      }
    },
    {
      "name": "Cancel Ride",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"rideId\": \"1\", \"cancelledByUserId\": \"r-1\", \"reason\": \"Changed plans\" }" },
        "url": "{{baseUrl}}/api/rides/1/cancel"
      }
    },
    {
      "name": "Update Ride Status",
      "request": {
        "method": "PATCH",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"rideId\": \"1\", \"status\": \"Enroute\", \"expectedVersion\": 2 }" },
        "url": "{{baseUrl}}/api/rides/1/status"
      }
    },
    {
      "name": "Nearby Drivers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/drivers/nearby?lat=37.775&lng=-122.418&radius=2000"
      }
    },
    {
      "name": "Submit Rating",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"rideId\": \"1\", \"fromUserId\": \"r-1\", \"toUserId\": \"d-2\", \"stars\": 5, \"comments\": \"Great ride\" }" },
        "url": "{{baseUrl}}/api/rides/1/rating"
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    }
  ]
}
